* text=auto eol=lf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
# Unity serializes empty YAML fields with a trailing space. Preserve its format.
Game/**/*.meta whitespace=-blank-at-eol
Game/**/*.asset whitespace=-blank-at-eol
Game/**/*.mat whitespace=-blank-at-eol
Game/**/*.prefab whitespace=-blank-at-eol
Game/**/*.unity whitespace=-blank-at-eol
Game/**/*.wlt whitespace=-blank-at-eol
# Keep the shipped Unity tutorial unchanged, including whitespace on empty lines.
Game/Assets/TutorialInfo/Scripts/Editor/ReadmeEditor.cs whitespace=-blank-at-eol
